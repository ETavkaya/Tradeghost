APP_NAME=TradeGhost
APP_ENV=dev
LOG_LEVEL=INFO

DATA_PROVIDER=yfinance
DATA_CACHE_TTL_SECONDS=21600
DATA_DEFAULT_PERIOD=2y
DATA_DEFAULT_INTERVAL=1d

SCORE_MOMENTUM_WEIGHT=0.25
SCORE_TREND_WEIGHT=0.25
SCORE_VOLATILITY_WEIGHT=0.15
SCORE_STRUCTURE_WEIGHT=0.20
SCORE_CONTEXT_WEIGHT=0.15
SWING_CANDIDATE_THRESHOLD=65

STRATEGY_ATR_STOP_MULTIPLE=1.5
STRATEGY_TP1_RR=1.8
STRATEGY_TP2_RR=3.0

BACKTEST_MIN_SCORE_TO_ENTER=68
BACKTEST_MAX_HOLD_DAYS=15
BACKTEST_WARMUP_BARS=120

# Frontend proxy backend target for local Next.js runtime (optional)
BACKEND_URL=http://localhost:8000

# Postgres report persistence
DATABASE_URL=postgresql://tradeghost:tradeghost@localhost:5432/tradeghost

# LLM provider setup
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLMQ_CHAT_MODEL=gpt-5-mini
DAILY_REPORT_LLM_MODEL=gpt-5-mini
MARKET_CONTEXT_LLM_MODEL=gpt-5-mini
FINAL_28D_REVIEW_LLM_MODEL=gpt-5.4-mini

# Automated cohort follow-up
DAILY_COHORT_FOLLOWUP_ENABLED=true
DAILY_COHORT_FOLLOWUP_SCHEDULE=23:30
DAILY_COHORT_FOLLOWUP_TIMEZONE=Europe/London
DAILY_COHORT_FOLLOWUP_POLL_SECONDS=60

# Ollama fallback / local debug
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=llama3.2:3b
