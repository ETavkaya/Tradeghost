APP_NAME=TradeGhost
APP_ENV=dev
LOG_LEVEL=INFO

DATA_PROVIDER=yfinance
DATA_CACHE_TTL_SECONDS=21600
DATA_DEFAULT_PERIOD=2y
DATA_DEFAULT_INTERVAL=1d

SCORE_MOMENTUM_WEIGHT=0.25
SCORE_TREND_WEIGHT=0.25
SCORE_VOLATILITY_WEIGHT=0.15
SCORE_STRUCTURE_WEIGHT=0.20
SCORE_CONTEXT_WEIGHT=0.15
SWING_CANDIDATE_THRESHOLD=65

STRATEGY_ATR_STOP_MULTIPLE=1.5
STRATEGY_TP1_RR=1.8
STRATEGY_TP2_RR=3.0

BACKTEST_MIN_SCORE_TO_ENTER=68
BACKTEST_MAX_HOLD_DAYS=15
BACKTEST_WARMUP_BARS=120

# Frontend proxy backend target for local Next.js runtime (optional)
BACKEND_URL=http://localhost:8000

# Postgres report persistence
DATABASE_URL=postgresql://tradeghost:tradeghost@localhost:5432/tradeghost

# Phase 2B deterministic research record versions
RESEARCH_RULE_VERSION=scanner_rules_v1
RESEARCH_FEATURE_VERSION=scanner_features_v1
RESEARCH_DATA_VERSION=market_data_daily_v1
RESEARCH_OUTCOME_EVALUATOR_VERSION=outcome_evaluator_v2
MARKET_REGIME_CLASSIFIER_VERSION=market_regime_v1
RESEARCH_RETRIEVAL_MIN_SAMPLE_SIZE=10
RESEARCH_RETRIEVAL_SOURCE_LIMIT=2000
RESEARCH_PATTERN_MIN_SAMPLE_SIZE=30
RESEARCH_PATTERN_MIN_EVALUABLE_RATIO=0.80
RESEARCH_PATTERN_MIN_DISTINCT_COHORTS=3
RESEARCH_PATTERN_MAX_SYMBOL_CONCENTRATION=0.50
RESEARCH_PATTERN_MIN_EFFECT_SIZE_PCT_POINTS=10.0
RESEARCH_PATTERN_MAX_P_VALUE=0.05
RESEARCH_PATTERN_SOURCE_LIMIT=5000

# Neo4j knowledge graph persistence
# The Docker bootstrap creates the application account tradeghost/admin.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=tradeghost
NEO4J_PASSWORD=admin
KNOWLEDGE_GRAPH_ENABLED=false
KNOWLEDGE_GRAPH_POLL_SECONDS=30
KNOWLEDGE_GRAPH_BATCH_SIZE=25
KNOWLEDGE_GRAPH_RETRY_SECONDS=60

# LLM provider setup
LLM_PROVIDER=openai
LLM_FALLBACK_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLMQ_CHAT_MODEL=gpt-5-mini
DAILY_REPORT_LLM_MODEL=gpt-5-mini
MARKET_CONTEXT_LLM_MODEL=gpt-5-mini
FINAL_28D_REVIEW_LLM_MODEL=gpt-5.4-mini

# Automated cohort follow-up
DAILY_COHORT_FOLLOWUP_ENABLED=true
DAILY_COHORT_FOLLOWUP_SCHEDULE=23:30
DAILY_COHORT_FOLLOWUP_TIMEZONE=Europe/London
DAILY_COHORT_FOLLOWUP_POLL_SECONDS=60

# Ollama fallback / local debug
OLLAMA_BASE_URL=http://localhost:11435
OLLAMA_MODEL=llama3.2:3b
